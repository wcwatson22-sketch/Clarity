{
  "_comment": "EXAMPLE FILE — safe to commit. Copy to appsettings.Production.json and fill in your domain. All secrets (JWT key, SMTP password, Stripe keys) go in /etc/clarity/env — never here.",

  "AppUrl": "https://clarityfinancialtools.com",

  "Admin": {
    "Username": "your_admin_username_here"
  },

  "AllowedOrigins": [
    "https://clarityfinancialtools.com"
  ],

  "Smtp": {
    "Host": "smtp.resend.com",
    "Port": 587,
    "Username": "resend",
    "FromEmail": "noreply@clarityfinancialtools.com",
    "FromName": "Clarity Finance"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
