{
  "_comment": "DEV CONFIG — secrets are overridden by environment variables in production. See .env.example.",
  "AppUrl": "http://localhost:4200",
  "Admin": {
    "Username": ""
  },
  "Jwt": {
    "Key": "DEV-ONLY-CHANGE-IN-PRODUCTION-USE-ENV-VAR-Jwt__Key",
    "Issuer": "clarity-api",
    "Audience": "clarity-app",
    // 720h = 30 days. Was 24h — too short for Face ID/Touch ID to be useful, since
    // /auth/refresh (called on biometric unlock) requires the EXISTING token to
    // still be valid; there is no separate long-lived refresh-token system, so a
    // fully expired token can only be recovered via the password login screen.
    // Extending this is a stopgap, not the ideal fix — a proper short-access-token
    // + long-lived-revocable-refresh-token architecture is the real fix, tracked
    // separately. Tradeoff of this stopgap: a leaked token stays valid longer, and
    // there is currently no server-side token revocation, so even a password
    // change does not invalidate previously-issued tokens until they expire.
    "ExpiryHours": 720
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "BasePriceId": "",
    "PremiumPriceId": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@clarityfinance.app",
    "FromName": "Clarity Finance"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Push": {
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "VapidSubject": "mailto:support@clarityfinancialtools.com"
  },
  "AllowedOrigins": [
    "http://localhost:4200",
    "http://localhost:3000",
    "http://localhost:5173",
    "http://localhost:5174",
    "capacitor://localhost",
    "http://localhost"
  ],
  "AllowedHosts": "*"
}
