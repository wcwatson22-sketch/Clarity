# ─────────────────────────────────────────────────────────────────────────────
# Clarity Finance — Production Environment File
#
# INSTRUCTIONS:
#   1. SSH into your server
#   2. sudo mkdir -p /etc/clarity
#   3. sudo nano /etc/clarity/env
#   4. Paste this file and fill in every value marked REPLACE_ME
#   5. sudo chmod 600 /etc/clarity/env && sudo chown root:root /etc/clarity/env
#
# This file is the SINGLE SOURCE OF TRUTH for all production config.
# It overrides everything in appsettings.json.
# ─────────────────────────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production

# ── Domain ───────────────────────────────────────────────────────────────────
AppUrl=https://clarityfinancialtools.com
AllowedOrigins__0=https://clarityfinancialtools.com

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
# Must be 32+ chars. If this is wrong or missing, the app refuses to start.
Jwt__Key=REPLACE_ME

# ── Test-account auto-login (optional — endpoint 404s until this is set) ──────
# Gates POST /api/test-auth/login-as-test-user, which mints a short-lived token
# for one hardcoded test account only. Generate with: openssl rand -base64 48
TestAuth__Secret=NOT_CONFIGURED

# ── SMTP / Email (Resend) ─────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier 3,000 emails/month
# Your Resend API key is used as the SMTP password.
Smtp__Host=smtp.resend.com
Smtp__Port=587
Smtp__Username=resend
Smtp__Password=REPLACE_ME
Smtp__FromEmail=noreply@clarityfinancialtools.com
Smtp__FromName=Clarity Finance

# ── Stripe (test mode — switch to sk_live_ when ready for real payments) ──────
# Dashboard: https://dashboard.stripe.com → Developers → API Keys
Stripe__SecretKey=REPLACE_ME

# Stripe → Products → your "Clarity Premium" product → Price ID
Stripe__PremiumPriceId=REPLACE_ME

# Stripe → Developers → Webhooks → your endpoint → Signing secret
# Add this AFTER you register the webhook (after first deployment)
Stripe__WebhookSecret=REPLACE_ME

# ── Weekly Performance Report (optional — inert until every value is set) ─────
# The scheduled email NEVER sends until WEEKLY_REPORT_RECIPIENT is configured.
# Do not set that until every source's numbers have been manually reconciled
# against its own dashboard — see DEPLOY.md "Weekly Report Rollout".
#
# Google Analytics 4 + Search Console (share one service-account key):
#   1. Google Cloud Console → create a service account, download its JSON key.
#   2. Restrict the file: chmod 600, store outside the web root (e.g. /etc/clarity/).
#   3. GA4 Admin → Property Access Management → add the service account email
#      as a "Viewer" (read-only).
#   4. Search Console → Settings → Users and permissions → add the same
#      service account email as a "Full user" (Search Console has no
#      read-only role below that).
# NOTE: these use "NOT_CONFIGURED" rather than "REPLACE_ME" — this whole section
# is optional (the report degrades gracefully with these sources marked
# unavailable), so it deliberately does not trip deploy.sh's REPLACE_ME check.
GA4_PROPERTY_ID=NOT_CONFIGURED
GOOGLE_APPLICATION_CREDENTIALS=/etc/clarity/google-service-account.json
SEARCH_CONSOLE_PROPERTY=https://clarityfinancialtools.com/
#
# App Store Connect (Sales and Trends Reports API):
#   1. App Store Connect → Users and Access → Integrations → App Store
#      Connect API → generate a key with the "Sales and Reports" role
#      (do NOT use Admin — this is the least-privileged role that can read reports).
#   2. Download the .p8 private key ONCE (Apple will not let you re-download it).
#   3. Restrict the file: chmod 600, store outside the web root.
#   4. Vendor number is on the Payments and Financial Reports page.
APPSTORE_CONNECT_ISSUER_ID=NOT_CONFIGURED
APPSTORE_CONNECT_KEY_ID=NOT_CONFIGURED
APPSTORE_CONNECT_PRIVATE_KEY_PATH=/etc/clarity/appstore-connect-key.p8
APPSTORE_APP_ID=NOT_CONFIGURED
APPSTORE_CONNECT_VENDOR_NUMBER=NOT_CONFIGURED
#
# Recipient + schedule — leave WEEKLY_REPORT_RECIPIENT as NOT_CONFIGURED until
# every source above has been manually reconciled (see DEPLOY.md); the
# scheduler and "Run Now" both no-op the send step without it.
WEEKLY_REPORT_RECIPIENT=NOT_CONFIGURED
WEEKLY_REPORT_TIMEZONE=America/New_York
# Optional — comma-separated username substrings to exclude from business
# metrics, beyond IsAdmin (which is always excluded). Defaults to "test,demo,seed".
WEEKLY_REPORT_EXCLUDED_USERNAME_PATTERNS=test,demo,seed
# Optional — AI-written executive summary. Defaults to disabled; the
# deterministic commentary is always the fallback. Not implemented in this
# release — reserved for a future addition.
WEEKLY_REPORT_AI_SUMMARY_ENABLED=false

# ── Credential rotation ────────────────────────────────────────────────────────
# Google service-account key: rotate from Cloud Console → IAM → Service Accounts
# → Keys → Add key, then delete the old key. Replace the file at
# GOOGLE_APPLICATION_CREDENTIALS and restart clarity-api. No app downtime — the
# report simply reports "unavailable" for one run if you swap the file mid-week.
#
# App Store Connect .p8 key: Apple allows only 2 active keys per team at once.
# Generate a new key, update APPSTORE_CONNECT_KEY_ID and the file at
# APPSTORE_CONNECT_PRIVATE_KEY_PATH, restart, then revoke the old key from
# App Store Connect once confirmed working.
